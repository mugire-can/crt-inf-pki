# --- Sensitive / raw deliverable files ---
# Course material and generated PKI material stay local.
*.pdf
*.pptx
*.docx
*.xml
!docs/**/*.xml

# Credentials / secrets / environment files
*.env
.env.*
*credentials*
*secrets*
*.key
*.pem
*.pfx
*.p12
*.csr
*token*

# OpenSSL CA state and issued certificate databases
**/index.txt*
**/serial*
**/crlnumber*
**/newcerts/
**/private/
**/certs/*.crt
**/crl/

# Database dumps / exports
*.bak
*.sql.gz
*.csv
!reports/**/*.csv.sample

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs / temp ---
*.log
*.tmp
temp/
tmp/

# --- Virtual machine artifacts ---
*.ova
*.ovf
*.vmdk
*.vdi
*.vbox
